---
import '../styles/global.css';
import data from '../data/products.json';

const products = data.products;
const categories = [...new Set(products.map((p) => p.category).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'th'));
const base = import.meta.env.BASE_URL;

const fmt = (n) => (n == null ? '—' : n.toLocaleString('th-TH'));
const modeLabel = (m) => (m === 'outright' ? 'บาท (ซื้อขาด)' : 'บาท/เดือน');
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>รายการสินค้า LG Subscribe</title>
    <meta name="description" content="รายการสินค้าและราคา LG Subscribe อัปเดตล่าสุดจากเอกสารราคา" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📦</text></svg>" />
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header-inner">
        <div class="brand">
          <span class="brand-mark">📦</span>
          <span>
            รายการสินค้า LG Subscribe
            <small>จากเอกสารราคา ส.ค. 2569</small>
          </span>
        </div>
        <div class="header-meta">{products.length} รายการ · {categories.length} หมวดหมู่</div>
      </div>
    </header>

    <main class="container">
      <div class="toolbar">
        <label class="search-box">
          <span aria-hidden="true">🔍</span>
          <input id="search" type="search" placeholder="ค้นหาชื่อ รุ่น หรือรหัสสินค้า…" autocomplete="off" />
        </label>
      </div>
      <div class="chips" id="chips">
        <button class="chip active" data-cat="">ทั้งหมด<span class="count">({products.length})</span></button>
        {categories.map((c) => (
          <button class="chip" data-cat={c}>
            {c}<span class="count">({products.filter((p) => p.category === c).length})</span>
          </button>
        ))}
      </div>
      <p class="result-count" id="result-count"></p>

      <div class="grid" id="grid">
        {products.map((p) => (
          <a class="card" href={`${base}product/${p.slug}/`} data-search={(p.name + ' ' + p.code + ' ' + (p.category || '')).toLowerCase()} data-cat={p.category || ''}>
            <div class="card-category">{p.category || 'อื่นๆ'}</div>
            {p.name !== p.code && <div class="card-name">{p.name}</div>}
            {!p.code.startsWith('XBOOM-') && <div class="card-code">{p.code}</div>}
            <div class="card-price">
              <span class="price-amount">{fmt(p.price)}</span>
              <span class="price-unit">{modeLabel(p.mode)}</span>
            </div>
          </a>
        ))}
      </div>
      <div class="empty" id="empty" hidden>ไม่พบสินค้าที่ค้นหา</div>
    </main>

    <footer class="site-footer container">
      ข้อมูลอัตโนมัติจากไฟล์ PDF ราคา — กรุณาตรวจสอบราคากับเอกสารต้นฉบับก่อนใช้งานจริง
    </footer>

    <script>
      const grid = document.getElementById('grid');
      const chips = document.getElementById('chips');
      const search = document.getElementById('search');
      const count = document.getElementById('result-count');
      const empty = document.getElementById('empty');
      let activeCat = '';

      function render() {
        const q = search.value.trim().toLowerCase();
        let shown = 0;
        for (const card of grid.querySelectorAll('.card')) {
          const okCat = !activeCat || card.dataset.cat === activeCat;
          const okQ = !q || card.dataset.search.includes(q);
          card.hidden = !(okCat && okQ);
          if (okCat && okQ) shown++;
        }
        count.textContent = `พบ ${shown} รายการ`;
        empty.hidden = shown !== 0;
      }

      chips.addEventListener('click', (e) => {
        const btn = e.target.closest('.chip');
        if (!btn) return;
        activeCat = btn.dataset.cat;
        for (const c of chips.querySelectorAll('.chip')) c.classList.toggle('active', c === btn);
        render();
      });

      search.addEventListener('input', render);
      render();
    </script>
  </body>
</html>
