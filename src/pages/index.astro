---
import fs from 'node:fs';
import '../styles/global.css';
import data from '../data/products.json';
import lgSpecs from '../data/lg-specs.json';
import pdfSpecs from '../data/pdf-specs.json';
import banners from '../data/banners.json';

const products = data.products;
const base = import.meta.env.BASE_URL;

// สเปคเด่น 2-3 รายการสำหรับ tooltip บนการ์ด (จากเว็บ LG Thailand + PDF ราคา)
const specMap = new Map([...lgSpecs.products, ...pdfSpecs.products].map((s) => [s.code, s]));
const tipMap = new Map();
for (const p of products) {
  const s = specMap.get(p.code);
  if (!s) continue;
  const items = (s.keySpecs && s.keySpecs.length) ? s.keySpecs
    : (s.features && s.features.length) ? s.features.map((f) => ({ name: 'คุณลักษณะ', value: f }))
    : (s.groups?.[0]?.specs || s.specs || []);
  tipMap.set(p.slug, items.filter((i) => i.name && i.value).slice(0, 3));
}

// รูปสินค้าที่สกัดจาก PDF (scripts/extract-images.mjs) — รุ่นไหนไม่มีรูปจะไม่แสดง <img>
const imgDir = process.cwd() + '/public/img/products';
const imgSlugs = new Set(fs.existsSync(imgDir) ? fs.readdirSync(imgDir).map((f) => f.replace(/\.jpg$/, '')) : []);

// รวมหมวดหมู่ย่อยเป็นกลุ่มหลักแบบ LG (ตู้เย็น / 2 ประตู → ตู้เย็น)
const topCat = (c) => (c || 'อื่นๆ').split(' / ')[0];

// ชื่อหัวข้อหมวดที่แสดง (ต่างจากชื่อหมวดในข้อมูล — ใช้กับหัวข้อใหญ่เท่านั้น ป้ายบนการ์ด/ชิปคงชื่อสั้น)
const catTitles = { 'Sound bar': 'Sound bar และ Bluetooth Speaker' };
const titleOf = (name) => catTitles[name] || name;

const groups = new Map();
for (const p of products) {
  const g = topCat(p.category);
  if (!groups.has(g)) groups.set(g, []);
  groups.get(g).push(p);
}
const sections = [...groups.entries()]
  .map(([name, list]) => ({ name, count: list.length, products: [...list].sort((a, b) => (a.price ?? 9e9) - (b.price ?? 9e9)) }))
  .sort((a, b) => a.name.localeCompare(b.name, 'th'));

const categories = sections.map((s) => s.name);

// ส่วน "ซื้อขาด VS Subscribe" — สินค้าที่มีราคาซื้อขาด (2Y) เทียบกับรายเดือนในตระกูลเดียวกัน
const compareItems = products
  .filter((p) => p.policies.some((r) => /^2Y/.test(r.policy)))
  .map((p) => {
    const outright = Math.min(...p.policies.filter((r) => /^2Y/.test(r.policy)).map((r) => r.price));
    const monthly = Math.min(
      ...products.filter((x) => x.code.startsWith(p.code.split('.')[0]) && x.mode !== 'outright' && x.price != null).map((x) => x.price)
    );
    return { code: p.code, name: p.name, outright, monthly };
  })
  .filter((c) => c.monthly != null && c.monthly !== Infinity)
  .slice(0, 2);

const fmt = (n) => (n == null ? '—' : n.toLocaleString('th-TH'));
const modeLabel = (m) => (m === 'outright' ? 'บาท (ซื้อขาด)' : 'บาท/เดือน');
const priceLabel = (m) => (m === 'outright' ? 'ซื้อขาด' : 'เริ่มต้น');

// ตัวอย่างตารางแผนใน hero — สินค้าที่มี policy หลากหลาย
const heroProduct = products.find((p) => p.policies.length >= 4) || products[0];
const policyRows = [...heroProduct.policies]
  .filter((r) => r.price != null)
  .slice(0, 4)
  .map((r) => ({ label: r.policy.replace(/[_ ]/g, ' '), price: r.price }));

---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>รายการสินค้า LG Subscribe</title>
    <meta name="description" content="แคตตาล็อกสินค้าและราคา LG Subscribe — เป็นเจ้าของเครื่องใช้ไฟฟ้า LG แบบรายเดือน พร้อมบริการดูแลโดยผู้เชี่ยวชาญ" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%23a50034'/><text x='50' y='68' font-size='52' text-anchor='middle' fill='white'>S</text></svg>" />
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header-inner">
        <a class="brand" href={`${base}`}>
          <span class="brand-mark">S</span>
          <span>
            LG Subscribe
            <small>รายการสินค้าและราคา ส.ค. 2569</small>
          </span>
        </a>
        <div class="header-meta">{products.length} รายการ · {categories.length} หมวดหมู่</div>
      </div>
    </header>

    <!-- Banner โปรโมชัน (จากหน้า LG Subscribe) -->
    {banners.slides.length > 0 && (
      <div class="banner-carousel" id="banner-carousel">
        <div class="banner-track">
          {banners.slides.map((s) => (
            <div class="banner-slide" data-cat={s.category || ''} data-query={s.query || ''} role="button" tabindex="0" aria-label={s.title ? `${s.title} — ดูสินค้าที่เกี่ยวข้อง` : 'โปรโมชัน LG Subscribe'}>
              <picture>
                {s.mobile && <source media="(max-width: 768px)" srcSet={`${base}${s.mobile.replace(/^\//, '')}`} />}
                {s.desktop && <source media="(min-width: 769px)" srcSet={`${base}${s.desktop.replace(/^\//, '')}`} />}
                <img src={`${base}${s.desktop.replace(/^\//, '')}`} alt={(s.title || '') + (s.subtitle ? ' — ' + s.subtitle : '')} loading="eager" />
              </picture>
              {(s.title || s.subtitle) && (
                <div class="banner-overlay">
                  <span class="banner-eyebrow">LG Subscribe</span>
                  {s.title && <b class="banner-title">{s.title}</b>}
                  {s.subtitle && <span class="banner-sub">{s.subtitle}</span>}
                </div>
              )}
              <div class="banner-caption">
                <span class="banner-caption-hint">
                  {s.query ? 'คลิกดูเฉพาะรุ่นที่เกี่ยวข้อง' : s.category ? `คลิกดูสินค้าหมวด ${s.category}` : 'คลิกดูสินค้าทั้งหมด'}
                </span>
                {s.category && <span class="banner-caption-cat">{s.category}</span>}
              </div>
            </div>
          ))}
        </div>
        {banners.slides.length > 1 && (
          <>
            <button class="banner-arrow prev" aria-label="สไลด์ก่อนหน้า">‹</button>
            <button class="banner-arrow next" aria-label="สไลด์ถัดไป">›</button>
            <div class="banner-dots">
              {banners.slides.map((_, i) => (
                <button class="banner-dot" data-i={i} aria-label={`สไลด์ ${i + 1}`}></button>
              ))}
            </div>
          </>
        )}
      </div>
    )}

    <!-- Hero -->
    <section class="hero">
      <div class="hero-inner">
        <div>
          <span class="hero-badge">● LG Subscribe — ราคา ส.ค. 2569</span>
          <h1>ครอบครองง่าย พร้อมบริการผู้เชี่ยวชาญจาก LG</h1>
          <p class="sub">
            เป็นเจ้าของเครื่องใช้ไฟฟ้า LG ได้โดยไม่ต้องจ่ายก้อนใหญ่ — แบ่งจ่ายเป็นรายเดือน
            พร้อมบริการดูแลรักษาโดยช่างผู้เชี่ยวชาญของ LG ตลอดอายุสัญญา
          </p>
          <div class="hero-stats">
            <div class="stat"><b>{products.length}</b><span>รุ่นสินค้า</span></div>
            <div class="stat"><b>{categories.length}</b><span>หมวดหมู่</span></div>
            <div class="stat"><b>5-7 ปี</b><span>แผน Subscribe</span></div>
          </div>
          <a class="hero-cta" href="#catalog">ดูแคตตาล็อกสินค้า ↓</a>
        </div>
        <div class="hero-visual">
          <div class="plan-label">ตัวอย่างแผนบริการ · {heroProduct.code}</div>
          {policyRows.map((r) => (
            <div class="plan-row">
              <span class="tag">{r.label}</span>
              <b>{fmt(r.price)} บาท/เดือน</b>
            </div>
          ))}
          <div class="plan-row">
            <span class="tag">ราคาเริ่มต้น</span>
            <b>{fmt(heroProduct.price)} บาท/เดือน</b>
          </div>
        </div>
      </div>
    </section>

    <main class="container">
      <!-- 3 ข้อดี -->
      <section class="benefits">
        <h2 class="section-title">3 ข้อดีของ LG Subscribe</h2>
        <p class="section-sub">เป็นเจ้าของได้จริง บริการดูแลครบ เครื่องใช้ไฟฟ้าคุณภาพระดับ LG</p>
        <div class="benefit-grid">
          <div class="benefit">
            <span class="ico">💳</span>
            <div>
              <h3>Easy Own — เป็นเจ้าของง่าย</h3>
              <p>แบ่งจ่ายรายเดือน ไม่ต้องจ่ายก้อนใหญ่ เข้าถึงสินค้าราคาพรีเมียมได้สบาย</p>
            </div>
          </div>
          <div class="benefit">
            <span class="ico">🛠️</span>
            <div>
              <h3>Easy Care — ดูแลโดยผู้เชี่ยวชาญ</h3>
              <p>บริการดูแลรักษาตามรอบโดยช่างผู้เชี่ยวชาญของ LG ตลอดอายุสัญญา</p>
            </div>
          </div>
          <div class="benefit">
            <span class="ico">📋</span>
            <div>
              <h3>หลากหลายแผน — เลือกได้ตามใจ</h3>
              <p>แผน 5 ปี / 6 ปี / 7 ปี และแบบ Visit (ถึงบ้าน) หรือ Self (เช็คเอง) ดูราคาได้ทุกรุ่น</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ซื้อขาด VS Subscribe -->
      {compareItems.length > 0 && (
        <section class="compare">
          <div>
            <h2>ซื้อขาด VS Subscribe</h2>
            <p>
              เปรียบเทียบราคาเครื่องกรองน้ำ LG — ซื้อขาดจ่ายครั้งเดียว หรือ Subscribe แบ่งจ่ายรายเดือน
              พร้อมบริการดูแลตลอดสัญญา
            </p>
          </div>
          <div class="compare-cols">
            {compareItems.map((c) => (
              <div class="compare-col">
                <span class="lbl">{c.code} · ซื้อขาด</span>
                <b>{fmt(c.outright)} บาท</b>
                <small>vs Subscribe เริ่ม {fmt(c.monthly)} บาท/เดือน</small>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- แคตตาล็อก -->
      <section class="catalog" id="catalog">
        <div class="catalog-head">
          <h2>แคตตาล็อกสินค้า</h2>
          <label class="search-box">
            <span aria-hidden="true">🔍</span>
            <input id="search" type="search" placeholder="ค้นหาชื่อ รุ่น หรือรหัสสินค้า…" autocomplete="off" />
          </label>
        </div>
        <div class="chips" id="chips">
          <button class="chip active" data-cat="">ทั้งหมด<span class="count">({products.length})</span></button>
          {categories.map((c) => (
            <button class="chip" data-cat={c}>
              {c}<span class="count">({groups.get(c).length})</span>
            </button>
          ))}
        </div>
        <p class="result-count" id="result-count"></p>

        {sections.map((sec) => (
          <div class="cat-section" data-cat={sec.name}>
            <div class="cat-head">
              <h3>{titleOf(sec.name)}</h3>
              <span class="cat-count">{sec.count} รุ่น</span>
            </div>
            <div class="grid">
              {sec.products.map((p) => (
                  <a
                    class="card"
                    href={`${base}product/${p.slug}/`}
                    data-search={(p.name + ' ' + p.code + ' ' + (p.category || '')).toLowerCase()}
                    data-cat={sec.name}
                  >
                    {imgSlugs.has(p.slug) && (
                      <img class="card-img" src={`${base}img/products/${p.slug}.jpg`} alt={p.name} loading="lazy" />
                    )}
                    <div class="card-category">{p.category || sec.name}</div>
                    {p.name !== p.code && <div class="card-name">{p.name}</div>}
                    <div class="card-code">{p.code}</div>
                    {tipMap.get(p.slug) && tipMap.get(p.slug).length > 0 && (
                      <div class="card-tip">
                        <div class="card-tip-title">สเปคเด่น</div>
                        {tipMap.get(p.slug).map((i) => (
                          <div class="card-tip-row">
                            <span>{i.name}</span>
                            <b>{i.value}</b>
                          </div>
                        ))}
                      </div>
                    )}
                    <div class="card-price">
                      <span>
                        <span class="price-from">{priceLabel(p.mode)}</span>
                        <span class="price-amount">{fmt(p.price)}</span>
                      </span>
                      <span class="price-unit">{modeLabel(p.mode)}</span>
                    </div>
                  </a>
              ))}
            </div>
          </div>
        ))}
        <div class="empty" id="empty" hidden>ไม่พบสินค้าที่ค้นหา</div>
      </section>
    </main>

    <footer class="site-footer container">
      ข้อมูลอัตโนมัติจากไฟล์ PDF ราคา ส.ค. 2569 — กรุณาตรวจสอบราคากับเอกสารต้นฉบับก่อนใช้งานจริง
    </footer>

    <script>
      const chips = document.getElementById('chips');
      const search = document.getElementById('search');
      const count = document.getElementById('result-count');
      const empty = document.getElementById('empty');
      const sections = [...document.querySelectorAll('.cat-section')];
      let activeCat = '';

      function render() {
        const q = search.value.trim().toLowerCase();
        let shown = 0;
        for (const sec of sections) {
          let vis = 0;
          for (const card of sec.querySelectorAll('.card')) {
            const okCat = !activeCat || card.dataset.cat === activeCat;
            const okQ = !q || card.dataset.search.includes(q);
            card.hidden = !(okCat && okQ);
            if (okCat && okQ) vis++;
          }
          sec.hidden = vis === 0;
          shown += vis;
        }
        count.textContent = `พบ ${shown} รายการ`;
        empty.hidden = shown !== 0;
      }

      chips.addEventListener('click', (e) => {
        const btn = e.target.closest('.chip');
        if (!btn) return;
        activeCat = btn.dataset.cat;
        for (const c of chips.querySelectorAll('.chip')) c.classList.toggle('active', c === btn);
        render();
      });

      search.addEventListener('input', render);
      render();
    </script>

    <script>
      // ── Banner carousel ──
      const carousel = document.getElementById('banner-carousel');
      if (carousel) {
        const track = carousel.querySelector('.banner-track');
        const slides = [...carousel.querySelectorAll('.banner-slide')];
        const dots = [...carousel.querySelectorAll('.banner-dot')];
        const prev = carousel.querySelector('.prev');
        const next = carousel.querySelector('.next');
        const count = slides.length;
        let idx = 0;
        let timer = null;

        const go = (i) => {
          idx = (i + count) % count;
          track.style.transform = `translateX(-${idx * 100}%)`;
          dots.forEach((d, j) => d.classList.toggle('active', j === idx));
        };
        const autoplay = () => {
          clearInterval(timer);
          timer = setInterval(() => go(idx + 1), 5000);
        };

        next && next.addEventListener('click', () => { go(idx + 1); autoplay(); });
        prev && prev.addEventListener('click', () => { go(idx - 1); autoplay(); });
        dots.forEach((d) => d.addEventListener('click', () => { go(+d.dataset.i); autoplay(); }));

        // ปัดนิ้ว (มือถือ)
        let startX = null;
        let swiped = false;
        carousel.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; swiped = false; }, { passive: true });
        carousel.addEventListener('touchend', (e) => {
          if (startX == null) return;
          const dx = e.changedTouches[0].clientX - startX;
          if (Math.abs(dx) > 40) { go(idx + (dx < 0 ? 1 : -1)); swiped = true; }
          autoplay();
          startX = null;
        }, { passive: true });

        // คลิกสไลด์ → เลื่อนไปแคตตาล็อก + กรอง (หมวด หรือ ค้นหาเฉพาะรุ่น)
        const openCatalog = (cat, query) => {
          const input = document.getElementById('search');
          if (query) {
            const allChip = [...document.querySelectorAll('.chip')].find((c) => c.dataset.cat === '');
            if (allChip) allChip.click();
            input.value = query;
            input.dispatchEvent(new Event('input'));
          } else {
            input.value = '';
            const chip = [...document.querySelectorAll('.chip')].find((c) => c.dataset.cat === cat);
            if (chip) chip.click();
          }
          document.getElementById('catalog').scrollIntoView({ behavior: 'smooth' });
        };
        slides.forEach((sl) => {
          const onClick = () => {
            if (swiped) return;
            openCatalog(sl.dataset.cat || '', sl.dataset.query || '');
          };
          sl.addEventListener('click', onClick);
          sl.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); onClick(); }
          });
        });

        // หยุดเลื่อนอัตโนมัติเมื่อชี้/สัมผัส
        carousel.addEventListener('mouseenter', () => clearInterval(timer));
        carousel.addEventListener('mouseleave', autoplay);

        go(0);
        autoplay();
      }
    </script>
  </body>
</html>
