---
import '../styles/global.css';

const base = import.meta.env.BASE_URL;

const sections = [
  {
    id: 'face-to-face',
    title: 'การลงทะเบียนปกติ (Face-to-Face)',
    subtitle: 'สั่งซื้อแบบพบหน้า',
    steps: [
      {
        title: 'เข้าสู่ระบบ OSMS',
        images: ['step-2.png'],
        items: [
          'เข้าใช้งานผ่าน OTP ผ่าน SMS หรือ Email',
        ],
      },
      {
        title: 'ลงทะเบียนลูกค้า',
        images: ['step-3.png'],
        items: [
          'เลือก "Subscription"',
          'เลือก "Type of Customer"',
          'ลงทะเบียนลูกค้า',
          'อัปโหลดรูปบัตรประชาชน',
        ],
      },
      {
        title: 'กรอกข้อมูลลูกค้า',
        images: ['step-4.png'],
        items: [
          'เลือก "Individual"',
          'คลิก "Validity Check"',
          'กรอกข้อมูลที่จำเป็น',
        ],
      },
      {
        title: 'ยืนยันตัวตนด้วย OTP',
        images: ['step-5.png', 'step-6.png'],
        items: [
          'คลิก "Send auth code"',
          'กรอก OTP จาก SMS ในช่องที่กำหนด',
          'คลิกปุ่ม "Validity Check"',
          'สำหรับอีเมล: กรอกอีเมลลูกค้า แล้วคลิก "ขอ OTP อีเมล"',
          'กรอกที่อยู่ลูกค้า',
        ],
      },
      {
        title: 'เลือกสินค้าและเงื่อนไข',
        images: ['step-7.png', 'step-8.png', 'step-9.png'],
        items: [
          'ลูกค้าอ่านข้อกำหนดและเงื่อนไข',
          'เลือกสินค้า',
          'เลือก Price Policy',
          'ระบุวันที่ติดตั้ง',
          'เลือกจุดขาย',
        ],
      },
      {
        title: 'เลือกโปรโมชันและวิธีชำระเงิน',
        images: ['step-10.png'],
        items: [
          'ลูกค้าอ่านข้อกำหนดและเงื่อนไข',
          'เลือกประเภทโปรโมชัน',
          'เลือกวิธีการชำระเงิน สำหรับการชำระ Recurring และ Advance Payment',
        ],
      },
      {
        title: 'ชำระเงิน',
        images: ['step-11.png'],
        items: [
          'เซ็นลายเซ็น (กรณีจ่ายเงินด้วยบัตรเครดิต)',
          'กรอกข้อมูลบัตร',
        ],
      },
    ],
  },
  {
    id: 'remote',
    title: 'การสั่งซื้อทางไกล (Remote Order)',
    subtitle: 'สั่งซื้อแบบไม่พบหน้า (Non-Face-to-Face)',
    steps: [
      {
        title: 'ฝั่ง LP (ผู้ขาย) — สร้างออเดอร์',
        images: ['step-13.png'],
        items: [
          'คลิก "Remote Order"',
          'กรอกข้อมูลที่จำเป็นทั้งหมด',
          'เลือกระหว่าง: 1. ลูกค้าในประเทศ  2. ลูกค้าต่างประเทศ',
          'กรอกเบอร์มือถือลูกค้า',
          'คลิก "Validity Check"',
          'ค้นหาที่อยู่',
        ],
      },
      {
        title: 'ฝั่ง LP — เลือกสินค้าและโปรโมชัน',
        images: ['step-14.png', 'step-15.png'],
        items: [
          'เลือกสินค้า',
          'เลือก Price Policy',
          'คลิกไอคอนเพื่อดูรายละเอียด',
          'เลือกจุดขาย',
          'เลือกประเภทโปรโมชัน',
          'คลิก "Send Remote Order"',
        ],
      },
      {
        title: 'ฝั่งลูกค้า — ลงทะเบียน',
        images: ['step-16.png'],
        items: [
          'กรอกข้อมูลที่จำเป็นทั้งหมด',
          'กรอกเลขบัตรประชาชน',
          'กรอกข้อมูลในหัวข้อ "ข้อมูลผู้สั่งซื้อ"',
          'คลิก "ตรวจสอบข้อมูลลูกค้า"',
        ],
      },
      {
        title: 'ฝั่งลูกค้า — ยืนยัน OTP',
        images: ['step-17.png'],
        items: [
          'คลิก "ขอ OTP SMS" — ระบบจะส่ง OTP ไปยังเบอร์มือถือลูกค้า',
          'กรอกหมายเลข OTP ที่ได้รับ',
          'คลิก "ยืนยัน OTP SMS"',
          'สำหรับอีเมล: กรอกอีเมลลูกค้า แล้วคลิก "ขอ OTP อีเมล"',
          'กรอก OTP จากอีเมล แล้วคลิก "ยืนยัน OTP Email"',
        ],
      },
      {
        title: 'ฝั่งลูกค้า — กรอกที่อยู่และชำระเงิน',
        images: ['step-18.png', 'step-19.png'],
        items: [
          'กรอกที่อยู่สำหรับติดตั้ง หรือคลิกเพื่อใช้ข้อมูลเดียวกับ "ข้อมูลผู้สั่งซื้อ"',
          'ลูกค้าอ่านข้อกำหนดและเงื่อนไขทั้งหมด',
          'เลือกวิธีชำระแบบ Recurring หรือ Advance Payment',
          'คลิก "ยืนยันคำสั่งซื้อ"',
        ],
      },
    ],
  },
];
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>วิธีการคีย์ข้อมูลสั่งซื้อ — LG Subscribe</title>
    <meta name="description" content="คู่มือวิธีการคีย์ข้อมูลสั่งซื้อผ่านระบบ OSMS สำหรับการลงทะเบียนแบบพบหน้าและสั่งซื้อทางไกล" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%23a50034'/><text x='50' y='68' font-size='52' text-anchor='middle' fill='white'>S</text></svg>" />
    <style>
      .step-img {
        display: block;
        width: 100%;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        margin-bottom: 12px;
        cursor: pointer;
        transition: box-shadow 0.2s;
      }
      .step-img:hover { box-shadow: 0 2px 12px rgba(0,0,0,0.15); }
      .step-img-full {
        position: fixed; inset: 0; z-index: 999; background: rgba(0,0,0,0.85);
        display: flex; align-items: center; justify-content: center; cursor: zoom-out;
      }
      .step-img-full img { max-width: 95vw; max-height: 95vh; border-radius: 8px; }
      .step-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; align-items: start; }
      @media (max-width: 640px) { .step-row { grid-template-columns: 1fr; } }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header-inner">
        <a class="brand" href={`${base}`}>
          <span class="brand-mark">S</span>
          <span>
            LG Subscribe
            <small>คู่มือการคีย์ข้อมูลสั่งซื้อ</small>
          </span>
        </a>
        <div class="header-meta">
          <a class="header-nav" href={`${base}`}>แคตตาล็อก</a>
          <a class="header-nav" href={`${base}services/`}>บริการดูแล</a>
          <span class="header-nav current">วิธีสั่งซื้อ</span>
        </div>
      </div>
    </header>

    <main class="container" style="max-width:960px;margin:0 auto;padding:24px 16px 80px">
      <div style="text-align:center;margin-bottom:40px">
        <h1 style="font-size:1.8rem;margin:0 0 8px">วิธีการคีย์ข้อมูลสั่งซื้อ</h1>
        <p style="color:#666;margin:0">คู่มือการใช้งานระบบ OSMS สำหรับการสั่งซื้อสินค้า LG Subscribe</p>
        <p style="color:#999;font-size:0.85rem;margin:4px 0 0">อัปเดต 24.07.2026</p>
      </div>

      <!-- Table of Contents -->
      <nav style="background:#f8f8f8;border-radius:12px;padding:20px 24px;margin-bottom:40px">
        <h2 style="font-size:1rem;margin:0 0 12px;color:#333">สารบัญ</h2>
        <ul style="margin:0;padding-left:20px;list-style:decimal">
          {sections.map((s) => (
            <li style="margin-bottom:8px">
              <a href={`#${s.id}`} style="color:#a50034;text-decoration:none;font-weight:600">{s.title}</a>
              <span style="color:#888;font-size:0.9rem"> — {s.subtitle}</span>
              <ul style="margin:4px 0 0;padding-left:20px;list-style:disc">
                {s.steps.map((step, i) => (
                  <li style="margin-bottom:2px;font-size:0.9rem">
                    <a href={`#${s.id}-${i}`} style="color:#555;text-decoration:none">{step.title}</a>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Sections -->
      {sections.map((section) => (
        <section id={section.id} style="margin-bottom:48px">
          <div style="border-left:4px solid #a50034;padding-left:16px;margin-bottom:24px">
            <h2 style="font-size:1.4rem;margin:0 0 4px;color:#1a1a1a">{section.title}</h2>
            <p style="color:#666;margin:0;font-size:0.95rem">{section.subtitle}</p>
          </div>

          {section.steps.map((step, i) => (
            <div id={`${section.id}-${i}`} style="background:#fff;border:1px solid #eee;border-radius:10px;padding:20px;margin-bottom:16px;scroll-margin-top:80px">
              <div style="display:flex;align-items:flex-start;gap:12px;margin-bottom:12px">
                <span style="background:#a50034;color:#fff;border-radius:50%;min-width:32px;height:32px;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.9rem">{i + 1}</span>
                <h3 style="margin:0;font-size:1.05rem;color:#333">{step.title}</h3>
              </div>
              <div class="step-row">
                <div>
                  {step.images.length > 1 ? (
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
                      {step.images.map((img) => (
                        <img
                          class="step-img"
                          src={`${base}how-to-order/${img}`}
                          alt={step.title}
                          loading="lazy"
                          onclick="this.classList.toggle('zoomed');var o=document.getElementById('overlay');if(o){o.style.display=o.style.display==='flex'?'none':'flex';o.querySelector('img').src=this.src}"
                        />
                      ))}
                    </div>
                  ) : (
                    <img
                      class="step-img"
                      src={`${base}how-to-order/${step.images[0]}`}
                      alt={step.title}
                      loading="lazy"
                      onclick="var o=document.getElementById('overlay');if(o){o.style.display='flex';o.querySelector('img').src=this.src}"
                    />
                  )}
                </div>
                <div>
                  <ul style="margin:0;padding-left:20px">
                    {step.items.map((item) => (
                      <li style="margin-bottom:6px;color:#444;line-height:1.6">{item}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          ))}
        </section>
      ))}

      <!-- Notes -->
      <div style="background:#fff9f0;border:1px solid #f0d8b0;border-radius:10px;padding:20px;margin-top:40px">
        <h3 style="margin:0 0 10px;color:#b8860b">หมายเหตุ</h3>
        <ul style="margin:0;padding-left:20px;color:#666">
          <li style="margin-bottom:6px">การยืนยันตัวตนต้องทำผ่าน OTP ทั้ง SMS และ Email</li>
          <li style="margin-bottom:6px">การสั่งซื้อทางไกล (Remote Order) ต้องส่งคำสั่งจากฝั่ง LP ก่อน แล้วลูกค้าค่อยยืนยัน</li>
          <li style="margin-bottom:6px">ตรวจสอบข้อมูลลูกค้าก่อนทำรายการทุกครั้ง</li>
        </ul>
      </div>
    </main>

    <!-- Image Lightbox -->
    <div id="overlay" style="display:none;position:fixed;inset:0;z-index:999;background:rgba(0,0,0,0.85);align-items:center;justify-content:center;cursor:zoom-out" onclick="this.style.display='none'">
      <img src="" style="max-width:95vw;max-height:95vh;border-radius:8px" />
    </div>

    <footer style="background:#1a1a1a;color:#888;text-align:center;padding:24px 16px;font-size:0.8rem">
      © 2026 LG Subscribe Catalog
    </footer>
  </body>
</html>
