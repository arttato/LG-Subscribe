---
import fs from 'node:fs';
import '../../styles/global.css';
import data from '../../data/products.json';
import lgSpecs from '../../data/lg-specs.json';
import { slugify } from '../../lib/utils';

export function getStaticPaths() {
  return data.products.map((p) => ({ params: { code: p.slug }, props: { p } }));
}

const { p } = Astro.props;
const imgPath = process.cwd() + '/public/img/products/' + p.slug + '.jpg';
const hasImg = fs.existsSync(imgPath);
const imgUrl = `${import.meta.env.BASE_URL}img/products/${p.slug}.jpg`;

const fmt = (n) => (n == null ? '—' : n.toLocaleString('th-TH'));
const modeLabel = (m) => (m === 'outright' ? 'บาท (ซื้อขาด)' : 'บาท/เดือน');
const base = import.meta.env.BASE_URL;
const titleText = p.code.startsWith('XBOOM-') ? p.name : p.name !== p.code ? `${p.name} — ${p.code}` : p.code;
const spec = lgSpecs.products.find((s) => s.code === p.code);
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titleText}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📦</text></svg>" />
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header-inner">
        <a class="brand" href={`${base}`}>
          <span class="brand-mark">📦</span>
          <span>
            รายการสินค้า LG Subscribe
            <small>จากเอกสารราคา ส.ค. 2569</small>
          </span>
        </a>
      </div>
    </header>

    <main class="container detail">
      <nav class="breadcrumb">
        <a href={`${base}`}>หน้าหลัก</a>
        <span> › </span>
        <span>{p.category || 'อื่นๆ'}</span>
        <span> › </span>
        <span>{p.code.startsWith('XBOOM-') ? p.name : p.code}</span>
      </nav>

      <section class="detail-head">
        {hasImg && <img class="detail-img" src={imgUrl} alt={p.name} />}
        <div class="detail-category">{p.category || 'อื่นๆ'}</div>
        {p.name !== p.code && <h1 class="detail-name">{p.name}</h1>}
        {!p.code.startsWith('XBOOM-') && <div class="detail-code">รุ่น: {p.code}</div>}
        <div class="price-row">
          <span class="price-amount">{fmt(p.price)}</span>
          <span class="price-unit">{modeLabel(p.mode)}</span>
          {p.priceNote && <span class="price-note">({p.priceNote})</span>}
        </div>
      </section>

      {spec && (
        <section class="specs">
          <h2 class="specs-title">คุณสมบัติและสเปค</h2>
          {spec.keySpecs.length > 0 && (
            <div class="specs-highlights">
              {spec.keySpecs.map((k) => (
                <div class="specs-highlight">
                  <div class="specs-highlight-name">{k.name}</div>
                  <div class="specs-highlight-value">{k.value}</div>
                </div>
              ))}
            </div>
          )}
          {spec.groups.map((g, gi) => (
            <details class="specs-group" open={gi === 0}>
              <summary>
                {g.title}
                <span class="specs-count">{g.specs.length}</span>
              </summary>
              <table class="specs-table">
                <tbody>
                  {g.specs.map((s) => (
                    <tr>
                      <th scope="row">{s.name}</th>
                      <td>{s.value}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </details>
          ))}
          <div class="specs-source">
            ข้อมูลจาก <a href={spec.url} target="_blank" rel="noopener">เว็บ LG Thailand</a>
          </div>
        </section>
      )}
    </main>

    <footer class="site-footer container">ข้อมูลอัตโนมัติจากไฟล์ PDF — กรุณาตรวจสอบกับเอกสารต้นฉบับก่อนใช้งานจริง</footer>
  </body>
</html>
