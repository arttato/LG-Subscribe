---
import fs from 'node:fs';
import '../../styles/global.css';
import data from '../../data/products.json';
import lgSpecs from '../../data/lg-specs.json';
import lgGallery from '../../data/lg-gallery.json';
import colorGalleries from '../../data/color-galleries.json';
import pdfSpecs from '../../data/pdf-specs.json';
import careData from '../../data/care.json';
import specCards from '../../data/spec-cards.json';
import { slugify } from '../../lib/utils';

export function getStaticPaths() {
  return data.products.map((p) => ({ params: { code: p.slug }, props: { p } }));
}

const { p } = Astro.props;
const imgPath = process.cwd() + '/public/img/products/' + p.slug + '.jpg';
const hasImg = fs.existsSync(imgPath);
const imgUrl = `${import.meta.env.BASE_URL}img/products/${p.slug}.jpg`;

const fmt = (n) => (n == null ? '—' : n.toLocaleString('th-TH'));
const modeLabel = (m) => (m === 'outright' ? 'บาท (ซื้อขาด)' : 'บาท/เดือน');
const priceLabel = (m) => (m === 'outright' ? 'ซื้อขาด' : 'เริ่มต้น');
const base = import.meta.env.BASE_URL;
// ชื่อเต็มจากเว็บ LG (ถ้ามี) — ใช้เป็นหัวข้อ/alt เหมือนเว็บจริง; XBOOM ใช้ชื่อเล่นจาก PDF
const fullName = (lgSpecs.products.find((s) => s.code === p.code)?.lgName) || p.name;
const titleText = fullName;
// สเปค: มาจากเว็บ LG (keySpecs + groups) หรือ PDF ราคา (specs รายการตรง)
let spec = null;
let specFromPdf = false;
const lgSpec = lgSpecs.products.find((s) => s.code === p.code);
if (lgSpec) spec = lgSpec;
else {
  const pdfSpec = pdfSpecs.products.find((s) => s.code === p.code);
  if (pdfSpec) {
    spec = { keySpecs: [], groups: [{ title: 'สเปคจากเอกสาร', specs: pdfSpec.specs }], url: null };
    specFromPdf = true;
  }
}
const gallery = lgGallery.products.find((s) => s.code === p.code);
// สีของรุ่น (เช่น เครื่องกรองน้ำ WD516/WD518 มี 3 สี) — ปุ่มสลับ gallery แยกสี
const colorInfo = colorGalleries.products.find((s) => s.code === p.code);
const colorVariants = colorInfo ? colorInfo.colors : [];
// สเปคการ์ด (รูปถ่ายจากเอกสาร LG) — ต่อท้าย gallery เสมอ ไม่เปลี่ยนตามสี
const specInfo = specCards.products.find((s) => s.code === p.code.split('.')[0]);
const specImages = specInfo ? specInfo.images.map((f) => `${base}img/specs/${f}`) : [];
// เตรียม JSON ไว้ให้ <script> อ่าน (เอา `</` ออกก่อนกัน HTML parser สะดุด)
const galleryJson = JSON.stringify({ baseImages: gallery ? gallery.images : [], variants: colorVariants, specs: specImages }).replaceAll('</', '\\u003c\\u002f');
const care = careData.products.find((s) => s.code === p.code);
// รูปบริการ: ใช้รูปเฉพาะรุ่น (care.img) ถ้ามี ไม่งั้นใช้หน้าที่ render จาก PDF (care-NN.png)
const careImg = care && (care.img ? `${base}img/care/${care.img}` : care.page ? `${base}img/care/care-${String(care.page).padStart(2, '0')}.png` : null);

// ── แผนการชำระเงิน (ทดลอง WD516) — คำนวณใน frontmatter (JS ล้วน ไม่ผ่าน expression slot ของ Astro) ──
const planCards = (() => {
  if (p.code !== 'WD516' || !p.policies.length) return null;
  const outright = p.policies.filter((x) => /^2Y/.test(x.policy));
  const monthly = p.policies.filter((x) => !/^2Y/.test(x.policy));
  const minMonthly = Math.min(...monthly.map((x) => x.price));
  const planName = (policy) => {
    const [yr, type] = policy.split('_');
    const svc =
      type === 'Visit'
        ? 'ช่างเข้าบริการถึงบ้าน'
        : type === 'Self'
          ? 'เปลี่ยนอะไหล่ด้วยตนเอง'
          : type || '';
    return { yr: yr.replace('Y', ' ปี'), svc };
  };
  const decodePromo = (x) => {
    const code = x.promoCode || '';
    const out = [];
    if (/^2Y/.test(x.policy)) {
      const dc = code.match(/DC(\d+)%/);
      if (dc) out.push(`ลด ${dc[1]}%`);
      const yr = code.match(/_(20\d{2})$/);
      if (yr) out.push(`แคมเปญ ${yr[1]}`);
    } else {
      const m1 = code.match(/PRO_(\d+)\((\d+)M\)?/); // วงเล็บปิดอาจถูกตัดใน PDF
      if (m1) out.push(`รอบบิลแรก ${m1[1]}.-`);
      const dc = code.match(/DC(\d+)%\((\d+)M\)?/);
      if (dc) out.push(`ลด ${dc[1]}% นาน ${dc[2]} รอบบิล`);
      const [type] = x.policy.split('_').slice(1);
      if (x.term) out.push(`${type === 'Visit' ? 'ช่างเข้าบริการ' : 'จัดส่งอะไหล่'}ทุก ${x.term} เดือน`);
    }
    return out.length ? out : null;
  };
  // ตารางรอบบิล (ค่าใช้จ่ายหลังหักส่วนลด): จาก promoCode + ระยะเวลาสัญญา
  const buildSchedule = (x) => {
    const code = x.promoCode || '';
    const m1 = code.match(/PRO_(\d+)\((\d+)M\)?/);
    const dc = code.match(/DC(\d+)%\((\d+)M\)?/);
    const yr = parseInt((x.policy || '').split('_')[0], 10) || 5;
    const total = yr * 12;
    const rows = [];
    if (m1) rows.push({ from: 1, to: +m1[2], price: +m1[1], note: 'รอบบิลแรก (ราคาโปร)' });
    if (dc) {
      const dFrom = rows.length ? rows[0].to + 1 : 1;
      rows.push({
        from: dFrom,
        to: dFrom + +dc[2] - 1,
        price: Math.floor((x.price * (100 - +dc[1])) / 100),
        note: `ลด ${dc[1]}%`,
      });
    }
    const fFrom = rows.length ? rows[rows.length - 1].to + 1 : 1;
    if (fFrom <= total) rows.push({ from: fFrom, to: total, price: x.price, note: 'ราคาปกติ' });
    const sum = rows.reduce((a, r) => a + r.price * (r.to - r.from + 1), 0);
    return { total, rows, sum };
  };
  const outrightPay = (x) => {
    const dc = (x.promoCode || '').match(/DC(\d+)%/);
    return dc ? Math.round((x.price * (100 - +dc[1])) / 100) : x.price;
  };
  return {
    outright: outright.map((x) => ({
      svc: planName(x.policy).svc,
      price: fmt(x.price),
      pay: fmt(outrightPay(x)),
      promo: decodePromo(x),
    })),
    monthly: monthly.map((x) => ({
      head: `${planName(x.policy).yr} · ${planName(x.policy).svc}`,
      svc: planName(x.policy).svc,
      yr: planName(x.policy).yr,
      price: `${fmt(x.price)} บาท/เดือน`,
      promo: decodePromo(x),
      schedule: buildSchedule(x),
      best: x.price === minMonthly,
    })),
  };
})();
---
<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titleText}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📦</text></svg>" />
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header-inner">
        <a class="brand" href={`${base}`}>
          <span class="brand-mark">📦</span>
          <span>
            รายการสินค้า LG Subscribe
            <small>จากเอกสารราคา ส.ค. 2569</small>
          </span>
        </a>
      </div>
    </header>

    <main class="container detail">
      <nav class="breadcrumb">
        <a href={`${base}`}>หน้าหลัก</a>
        <span> › </span>
        <span>{p.category || 'อื่นๆ'}</span>
        <span> › </span>
        <span>{fullName !== p.code ? fullName : p.code}</span>
      </nav>

      <section class="detail-head">
        {gallery ? (
          <div class="gallery" data-gallery>
            <script type="application/json" data-gallery-json set:html={galleryJson}></script>
            {colorVariants.length > 1 && (
              <div class="color-switcher" data-colors>
                {colorVariants.map((v, i) => (
                  <button class="color-chip" data-color={i} data-color-key={v.key} type="button" aria-pressed={i === 0} title={v.th}>
                    <span class="color-dot" style={`background:${v.swatch || '#999'}`} aria-hidden="true"></span>
                    {v.en || v.th}
                  </button>
                ))}
              </div>
            )}
            <div class="gallery-stage">
              <button class="gallery-nav prev" aria-label="รูปก่อนหน้า" data-prev>‹</button>
              <img class="detail-img gallery-img" src={gallery.images[0]} alt={fullName} data-img />
              <button class="gallery-nav next" aria-label="รูปถัดไป" data-next>›</button>
              <span class="gallery-count" data-count>1 / {gallery.images.length}</span>
              <span class="gallery-zoom" aria-hidden="true">🔍</span>
            </div>
            <div class="gallery-thumbs" data-thumbs>
              {gallery.images.map((u, i) => (
                <button class="gallery-thumb" data-thumb={i} aria-label={`มุม ${i + 1}`}>
                  <img src={u} alt={`มุม ${i + 1}`} loading="lazy" />
                </button>
              ))}
            </div>
          </div>
        ) : (
          hasImg && <img class="detail-img" src={imgUrl} alt={fullName} data-single-img title="กดเพื่อดูรูปใหญ่" />
        )}
        <div class="detail-category">{p.category || 'อื่นๆ'}</div>
        {fullName !== p.code && <h1 class="detail-name" data-color-name>{fullName}</h1>}
        {!p.code.startsWith('XBOOM-') && <div class="detail-code" data-color-code>รุ่น: {p.code}</div>}
        <div class="price-row">
          <span class="price-from">{priceLabel(p.mode)}</span>
          <span class="price-amount">{fmt(p.price)}</span>
          <span class="price-unit">{modeLabel(p.mode)}</span>
          {p.priceNote && <span class="price-note">({p.priceNote})</span>}
        </div>
        <button class="btn btn-primary btn-interest" data-open-inquiry>สนใจรุ่นนี้</button>
      </section>

            {planCards && (
        <section class="plans">
          <h2 class="plans-title">แผนการชำระเงิน</h2>
          {planCards.outright.length > 0 && (
            <div class="plans-group">
              <div class="plans-group-title">
                <span>ซื้อขาด</span>
                <small>จ่ายครั้งเดียว · รับประกัน 2 ปี</small>
              </div>
              <div class="plans-cards">
                {planCards.outright.map((x) => (
                  <div
                    class="plan-card"
                    data-plan
                    data-plan-outright
                    data-plan-price={x.price}
                    data-plan-pay={x.pay}
                    data-plan-promo={JSON.stringify(x.promo || [])}
                    data-plan-svc={x.svc}
                    role="button"
                    tabindex="0"
                    aria-label={`ดูรายละเอียด ${x.svc}`}
                  >
                    <div class="plan-card-head">{x.svc}</div>
                    <div class="plan-card-price">{x.price} <span>บาท</span></div>
                    <ul class="plan-card-promo">
                      {(x.promo || []).map((t) => (
                        <li>{t}</li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </div>
          )}
          {planCards.monthly.length > 0 && (
            <div class="plans-group">
              <div class="plans-group-title">
                <span>Subscribe รายเดือน</span>
                <small>รวมค่าดูแลตลอดสัญญา</small>
              </div>
              <div class="plans-cards">
                {planCards.monthly.map((x) => (
                  <div
                    class={`plan-card${x.best ? ' is-best' : ''}`}
                    data-plan
                    data-plan-schedule={JSON.stringify(x.schedule)}
                    data-plan-head={x.head}
                    data-plan-price={x.price}
                    data-plan-promo={JSON.stringify(x.promo || [])}
                    role="button"
                    tabindex="0"
                    aria-label={`ดูรายละเอียด ${x.head}`}
                  >
                    <div class="plan-card-head">
                      <b>{x.yr}</b>
                      <span class="plan-card-svc">{x.svc}</span>
                      {x.best && <span class="plans-best">เริ่มต้น</span>}
                    </div>
                    <div class="plan-card-price">{x.price}</div>
                    <ul class="plan-card-promo">
                      {(x.promo || []).map((t) => (
                        <li>{t}</li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </div>
          )}
        </section>
      )}

      {spec && (
        <section class="specs">
          <h2 class="specs-title">{spec.features && spec.features.length > 0 ? 'คุณลักษณะที่สำคัญ' : 'คุณสมบัติและสเปค'}</h2>
          {spec.features && spec.features.length > 0 ? (
            <ul class="specs-features">
              {spec.features.map((f) => (
                <li>{f}</li>
              ))}
            </ul>
          ) : spec.keySpecs.length > 0 ? (
            <div class="specs-highlights">
              {spec.keySpecs.map((k) => (
                <div class="specs-highlight">
                  <div class="specs-highlight-name">{k.name}</div>
                  <div class="specs-highlight-value">{k.value}</div>
                </div>
              ))}
            </div>
          ) : (
            spec.groups.map((g, gi) => (
              <details class="specs-group" open={gi === 0}>
                <summary>
                  {g.title}
                  <span class="specs-count">{g.specs.length}</span>
                </summary>
                <table class="specs-table">
                  <tbody>
                    {g.specs.map((s) => (
                      <tr>
                        <th scope="row">{s.name}</th>
                        <td>{s.value}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </details>
            ))
          )}
          <div class="specs-source">
            {specFromPdf ? 'ข้อมูลจากเอกสาร PDF ราคา (คอลัมน์รายการสินค้า)' : (
              <>ข้อมูลจาก <a href={spec.url} target="_blank" rel="noopener">เว็บ LG Thailand</a></>
            )}
          </div>
        </section>
      )}

      {p.gift && p.gift.image && (
        <section class="gift">
          <h2 class="gift-title">ของแถมฟรี</h2>
          <div class="gift-box">
            <img class="gift-img" src={p.gift.image} alt={`ของแถม: ${p.gift.name}`} loading="lazy" />
            <div class="gift-info">
              <div class="gift-name">{p.gift.name}</div>
              {p.gift.promo && <div class="gift-promo">{p.gift.promo}</div>}
              {p.gift.condition && <div class="gift-cond">เงื่อนไข: {p.gift.condition}</div>}
              <div class="gift-note">รับฟรีเมื่อสมัคร Subscribe รุ่นนี้ — ตามเงื่อนไขของแคมเปญ</div>
            </div>
          </div>
        </section>
      )}

      {careImg && (
        <section class="care">
          <h2 class="care-title">บริการดูแลจากผู้เชี่ยวชาญ LG</h2>
          <div class="care-body">
            <div class="care-img-wrap">
              <img class="care-img" src={careImg} alt={care.title || 'บริการดูแล'} loading="lazy" data-care-img />
              <span class="gallery-zoom" aria-hidden="true">🔍</span>
            </div>
            <p class="care-caption">
              {care.title || 'บริการดูแล'} — ตามเอกสาร <b>Care Service 2026</b> สำหรับลูกค้า Subscribe
            </p>
            <a class="care-more" href={`${base}services/`}>ดูบริการดูแลทั้งหมด ›</a>
          </div>
        </section>
      )}
    </main>

    <!-- ดูรูปขยายเต็มจอ -->
    <div class="lightbox" data-lightbox hidden>
      <div class="lightbox-backdrop" data-lightbox-close></div>
      <div class="lightbox-actions">
        <button class="lightbox-action" data-lightbox-share title="คัดลอกลิงก์สินค้า" aria-label="คัดลอกลิงก์สินค้า">🔗</button>
        <button class="lightbox-action" data-lightbox-share-img title="คัดลอกลิงก์รูป" aria-label="คัดลอกลิงก์รูป">🖼️</button>
      </div>
      <button class="lightbox-close" data-lightbox-close aria-label="ปิด">✕</button>
      <button class="lightbox-nav prev" data-lightbox-prev aria-label="รูปก่อนหน้า">‹</button>
      <img class="lightbox-img" data-lightbox-img alt="" />
      <button class="lightbox-nav next" data-lightbox-next aria-label="รูปถัดไป">›</button>
      <span class="lightbox-count" data-lightbox-count></span>
    </div>

    <!-- แบบฟอร์มสอบถามราคา -->
    <div class="inquiry" data-inquiry hidden data-name={fullName} data-code={p.code} data-price={fmt(p.price)} data-pricelabel={priceLabel(p.mode)}>
      <div class="inquiry-backdrop" data-inquiry-close></div>
      <div class="inquiry-box" role="dialog" aria-modal="true" aria-labelledby="inquiry-title">
        <button class="inquiry-close" data-inquiry-close aria-label="ปิด">×</button>
        <h3 id="inquiry-title">สนใจรุ่นนี้</h3>
        <div class="inquiry-product">
          <div class="inquiry-name">{fullName}</div>
          <div class="inquiry-code">{p.code}</div>
          <div class="inquiry-price">
            <span class="price-from">{priceLabel(p.mode)}</span>
            <b>{fmt(p.price)}</b> บาท/เดือน
          </div>
        </div>
        <label class="inquiry-field">
          <span>ชื่อ-นามสกุล</span>
          <input type="text" data-field="name" placeholder="เช่น สมชาย ใจดี" autocomplete="name" />
        </label>
        <label class="inquiry-field">
          <span>เบอร์โทร / LINE ID</span>
          <input type="text" data-field="contact" placeholder="เช่น 081-234-5678" />
        </label>
        <label class="inquiry-field">
          <span>ข้อความเพิ่มเติม</span>
          <textarea data-field="note" rows="3" placeholder="คำถามหรือรายละเอียดที่อยากสอบถาม (ไม่บังคับ)"></textarea>
        </label>
        <div class="inquiry-actions">
          <a class="btn btn-primary" data-inquiry-line target="_blank" rel="noopener">ส่งผ่าน LINE</a>
          <a class="btn btn-ghost" data-inquiry-mail>ส่งอีเมล</a>
          <button class="btn btn-ghost" data-inquiry-copy>คัดลอกข้อความ</button>
        </div>
        <p class="inquiry-hint" data-inquiry-hint role="status"></p>
      </div>
    </div>

    <!-- รายละเอียดแผนการชำระ (คลิกการ์ด) -->
    <div class="plan-detail" data-plan-detail hidden>
      <div class="plan-detail-backdrop" data-plan-close></div>
      <div class="plan-detail-box" role="dialog" aria-modal="true" aria-labelledby="plan-detail-title">
        <button class="plan-detail-close" data-plan-close aria-label="ปิด">×</button>
        <h3 id="plan-detail-title" data-plan-title></h3>
        <div class="plan-detail-sub" data-plan-sub></div>
        <div class="plan-detail-body" data-plan-body></div>
      </div>
    </div>

    <script>
      const planDetail = document.querySelector('[data-plan-detail]');
      if (planDetail) {
        const planTitle = planDetail.querySelector('[data-plan-title]');
        const planSub = planDetail.querySelector('[data-plan-sub]');
        const planBody = planDetail.querySelector('[data-plan-body]');
        const openPlan = () => { planDetail.hidden = false; document.body.style.overflow = 'hidden'; };
        const closePlan = () => { planDetail.hidden = true; document.body.style.overflow = ''; };
        const fmtB = (n) => Number(n).toLocaleString('th-TH');
        const renderRows = (s, promo) => {
          const t = document.createElement('table');
          t.className = 'plan-detail-table';
          t.innerHTML = '<thead><tr><th>รอบบิล</th><th>ราคา/เดือน</th><th>หมายเหตุ</th></tr></thead>';
          const tb = document.createElement('tbody');
          for (const r of s.rows) {
            const tr = document.createElement('tr');
            const label = r.from === r.to ? 'รอบบิลที่ ' + r.from : 'รอบบิลที่ ' + r.from + '–' + r.to;
            tr.innerHTML = '<td>' + label + '</td><td>' + fmtB(r.price) + ' บาท</td><td>' + r.note + '</td>';
            tb.appendChild(tr);
          }
          t.appendChild(tb);
          const notice = document.createElement('div');
          notice.className = 'plan-detail-notice';
          const items = [
            'ยอดค่าบริการที่ต้องชำระและรายละเอียดการผ่อนชำระขึ้นอยู่กับสินค้าและแผนที่เลือก',
            'ราคาในภาพแสดงเพียงส่วนลด อาจมีส่วนลดเพิ่มเติมหากซื้อสินค้าเพิ่มขึ้น',
          ];
          items.forEach((txt, i) => {
            const item = document.createElement('div');
            item.className = 'plan-detail-notice-item';
            const num = document.createElement('span');
            num.className = 'plan-detail-notice-num';
            num.textContent = '*'.repeat(i + 1);
            const span = document.createElement('span');
            span.textContent = txt;
            item.append(num, span);
            notice.appendChild(item);
          });
          const promoList = document.createElement('ul');
          promoList.className = 'plan-detail-promo';
          (promo || []).forEach((p) => {
            const li = document.createElement('li');
            li.textContent = p;
            promoList.appendChild(li);
          });
          planBody.replaceChildren(promoList, t, notice);
        };
        const renderOutright = (price, pay, promo, svc) => {
          const box = document.createElement('div');
          box.className = 'plan-detail-outright';
          const p0 = document.createElement('p');
          p0.textContent = 'จ่ายครั้งเดียว พร้อมรับประกัน 2 ปี';
          box.appendChild(p0);
          const priceRow = document.createElement('div');
          priceRow.className = 'plan-detail-outright-price';
          if (pay !== price) {
            const old = document.createElement('span');
            old.className = 'old';
            old.textContent = price + ' บาท';
            const now = document.createElement('span');
            now.className = 'now';
            now.textContent = pay + ' บาท';
            priceRow.append(old, now);
          } else {
            const now = document.createElement('span');
            now.className = 'now';
            now.textContent = price + ' บาท';
            priceRow.appendChild(now);
          }
          box.appendChild(priceRow);
          const promoList = document.createElement('ul');
          promoList.className = 'plan-detail-promo';
          (promo || []).forEach((p) => {
            const li = document.createElement('li');
            li.textContent = p;
            promoList.appendChild(li);
          });
          box.appendChild(promoList);
          const svcNote = document.createElement('p');
          svcNote.className = 'plan-detail-svc';
          svcNote.textContent = 'บริการ: ' + svc + ' · รับประกัน 2 ปี';
          box.appendChild(svcNote);
          planBody.replaceChildren(box);
        };
        document.querySelectorAll('[data-plan]').forEach((card) => {
          const open = () => {
            planTitle.textContent = card.dataset.planHead || card.dataset.planSvc || 'แผนการชำระเงิน';
            planSub.textContent = card.dataset.planPrice ? 'ราคา ' + card.dataset.planPrice : '';
            if (card.dataset.planOutright !== undefined) {
              renderOutright(card.dataset.planPrice, card.dataset.planPay, JSON.parse(card.dataset.planPromo || '[]'), card.dataset.planSvc);
            } else {
              renderRows(JSON.parse(card.dataset.planSchedule), JSON.parse(card.dataset.planPromo || '[]'));
            }
            openPlan();
          };
          card.addEventListener('click', open);
          card.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              open();
            }
          });
        });
        planDetail.querySelectorAll('[data-plan-close]').forEach((el) => el.addEventListener('click', closePlan));
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closePlan(); });
      }

      const inq = document.querySelector('[data-inquiry]');
      if (inq) {
        const name = inq.dataset.name;
        const code = inq.dataset.code;
        const price = inq.dataset.price;
        const priceLabel = inq.dataset.pricelabel;
        const fields = {
          name: inq.querySelector('[data-field="name"]'),
          contact: inq.querySelector('[data-field="contact"]'),
          note: inq.querySelector('[data-field="note"]'),
        };
        const hint = inq.querySelector('[data-inquiry-hint]');
        const buildMsg = () => {
          const lines = [`สนใจรุ่น ${name}`];
          lines.push(`รุ่น: ${code}`);
          lines.push(`ราคา${priceLabel === 'ซื้อขาด' ? 'ซื้อขาด' : 'เริ่มต้น'}: ${price} บาท/เดือน`);
          if (fields.name.value.trim()) lines.push(`ชื่อ: ${fields.name.value.trim()}`);
          if (fields.contact.value.trim()) lines.push(`เบอร์โทร/LINE: ${fields.contact.value.trim()}`);
          if (fields.note.value.trim()) lines.push('', fields.note.value.trim());
          return lines.join('\n');
        };
        const open = () => { inq.hidden = false; document.body.style.overflow = 'hidden'; };
        const close = () => { inq.hidden = true; document.body.style.overflow = ''; hint.textContent = ''; };
        document.querySelectorAll('[data-open-inquiry]').forEach((b) => b.addEventListener('click', open));
        inq.querySelectorAll('[data-inquiry-close]').forEach((el) => el.addEventListener('click', close));
        inq.querySelector('[data-inquiry-line]').addEventListener('click', function () {
          this.href = 'https://line.me/R/msg/text/?' + encodeURIComponent(buildMsg());
        });
        inq.querySelector('[data-inquiry-mail]').addEventListener('click', function () {
          this.href = 'mailto:?subject=' + encodeURIComponent('สนใจ ' + name + ' (' + code + ')') + '&body=' + encodeURIComponent(buildMsg());
        });
        inq.querySelector('[data-inquiry-copy]').addEventListener('click', async function () {
          try {
            await navigator.clipboard.writeText(buildMsg());
            hint.textContent = '✅ คัดลอกข้อความแล้ว — ไปวางใน LINE / แชทได้เลย';
          } catch {
            hint.textContent = 'คัดลอกไม่สำเร็จ — ลองกดปุ่มส่งผ่าน LINE/อีเมลแทน';
          }
        });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
      }

      // Lightbox — ดูรูปขยายเต็มจอ (แกลเลอรี่ + รูปบริการดูแล + รูปเดี่ยว)
      const lb = document.querySelector('[data-lightbox]');
      let lbMode = '';
      let lbList = [];
      let lbIdx = 0;
      let lbNav = null;
      let lbOpen = null;
      let lbRender = null;
      if (lb) {
        const lbImg = lb.querySelector('[data-lightbox-img]');
        const lbCount = lb.querySelector('[data-lightbox-count]');
        const lbPrev = lb.querySelector('[data-lightbox-prev]');
        const lbNext = lb.querySelector('[data-lightbox-next]');
        const lbCloseBtns = [...lb.querySelectorAll('[data-lightbox-close]')];
        lbRender = () => {
          const multi = lbMode === 'gallery' && lbList.length > 1;
          lbPrev.hidden = !multi;
          lbNext.hidden = !multi;
          lbCount.hidden = !multi;
          if (multi) lbCount.textContent = (lbIdx + 1) + ' / ' + lbList.length;
          lbImg.src = lbList[lbIdx] || '';
        };
        lbOpen = (mode, list, i) => {
          lbMode = mode;
          lbList = list;
          lbIdx = i;
          lbRender();
          lb.hidden = false;
          document.body.style.overflow = 'hidden';
        };
        const lbClose = () => {
          lb.hidden = true;
          lbImg.removeAttribute('src');
          document.body.style.overflow = '';
        };
        lbCloseBtns.forEach((b) => b.addEventListener('click', lbClose));
        lbPrev.addEventListener('click', () => { if (lbNav) lbNav(lbIdx - 1); });
        lbNext.addEventListener('click', () => { if (lbNav) lbNav(lbIdx + 1); });
        // ปุ่มแชร์/คัดลอกลิงก์ (สินค้า + รูป)
        const fallbackCopy = (text) => {
          try {
            const ta = document.createElement('textarea');
            ta.value = text;
            ta.style.position = 'fixed';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.select();
            const ok = document.execCommand('copy');
            document.body.removeChild(ta);
            return ok;
          } catch { return false; }
        };
        const copyWithFeedback = (btn, text) => {
          const prev = btn.innerHTML;
          const done = () => {
            const prevLabel = btn.getAttribute('aria-label');
            btn.classList.add('copied');
            btn.innerHTML = '✓';
            btn.setAttribute('aria-label', 'คัดลอกแล้ว');
            setTimeout(() => { btn.classList.remove('copied'); btn.innerHTML = prev; btn.setAttribute('aria-label', prevLabel); }, 1600);
          };
          const fail = () => {
            btn.innerHTML = '⚠';
            setTimeout(() => { btn.innerHTML = prev; }, 1600);
          };
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(done).catch(() => { fallbackCopy(text) ? done() : fail(); });
          } else {
            fallbackCopy(text) ? done() : fail();
          }
        };
        const shareBtn = lb.querySelector('[data-lightbox-share]');
        if (shareBtn) shareBtn.addEventListener('click', () => copyWithFeedback(shareBtn, location.href));
        const shareImgBtn = lb.querySelector('[data-lightbox-share-img]');
        if (shareImgBtn) shareImgBtn.addEventListener('click', () => copyWithFeedback(shareImgBtn, lbImg.src));
        document.addEventListener('keydown', (e) => {
          if (lb.hidden) return;
          if (e.key === 'Escape') lbClose();
          if (lbMode === 'gallery' && lbNav) {
            if (e.key === 'ArrowLeft') lbNav(lbIdx - 1);
            if (e.key === 'ArrowRight') lbNav(lbIdx + 1);
          }
        });
        // รูปบริการดูแล → เปิด lightbox (รูปเดียว)
        const careImgEl = document.querySelector('[data-care-img]');
        if (careImgEl) careImgEl.addEventListener('click', () => lbOpen('care', [careImgEl.src], 0));
        // รูปเดี่ยว (รุ่นที่ไม่มีแกลเลอรี่) → เปิด lightbox
        const singleImg = document.querySelector('[data-single-img]');
        if (singleImg) singleImg.addEventListener('click', () => lbOpen('care', [singleImg.src], 0));
      }

      const gal = document.querySelector('[data-gallery]');
      if (gal) {
        const galleryData = JSON.parse(document.querySelector('[data-gallery-json]').textContent);
        const baseImages = galleryData.baseImages;
        const variants = galleryData.variants;
        const thumbsWrap = gal.querySelector('[data-thumbs]');
        const imgEl = gal.querySelector('[data-img]');
        const countEl = gal.querySelector('[data-count]');
        const nameEl = document.querySelector('[data-color-name]');
        const codeEl = document.querySelector('[data-color-code]');
        const chips = [...gal.querySelectorAll('[data-color]')];
        let colorIdx = 0;
        const specs = galleryData.specs || [];
        const curImages = () => [...(variants.length ? variants[colorIdx].images : baseImages), ...specs];
        let cur = 0;
        const isSpec = (u) => u.includes('/img/specs/');

        const renderThumbs = () => {
          thumbsWrap.innerHTML = curImages()
            .map((u, i) => `<button class="gallery-thumb${isSpec(u) ? ' spec' : ''}" data-thumb="${i}" aria-label="มุม ${i + 1}"><img src="${u}" alt="มุม ${i + 1}" loading="lazy">${isSpec(u) ? '<span class="thumb-tag">สเปค</span>' : ''}</button>`)
            .join('');
        };

        const show = (i) => {
          const imgs = curImages();
          cur = (i + imgs.length) % imgs.length;
          imgEl.src = imgs[cur];
          imgEl.alt = nameEl ? nameEl.textContent : imgEl.alt;
          countEl.textContent = cur + 1 + ' / ' + imgs.length;
          thumbsWrap.querySelectorAll('[data-thumb]').forEach((t, ti) => t.classList.toggle('active', ti === cur));
        };

        const setColor = (i) => {
          colorIdx = i;
          const v = variants[i];
          chips.forEach((c, ci) => {
            c.classList.toggle('active', ci === i);
            c.setAttribute('aria-pressed', ci === i ? 'true' : 'false');
          });
          if (v) {
            if (nameEl && v.lgName) nameEl.textContent = v.lgName;
            if (codeEl && v.model) codeEl.textContent = 'รุ่น: ' + v.model;
          }
          renderThumbs();
          show(0);
        };

        if (lbOpen) {
          lbNav = (i) => { show(i); lbIdx = cur; lbRender(); };
          imgEl.addEventListener('click', () => lbOpen('gallery', curImages(), cur));
        }
        chips.forEach((c, i) => c.addEventListener('click', () => setColor(i)));
        gal.querySelector('[data-prev]').addEventListener('click', () => show(cur - 1));
        gal.querySelector('[data-next]').addEventListener('click', () => show(cur + 1));
        thumbsWrap.addEventListener('click', (e) => {
          const t = e.target.closest('[data-thumb]');
          if (t) show(parseInt(t.dataset.thumb, 10));
        });
        if (variants.length) {
          const want = new URLSearchParams(location.search).get('color');
          const idx = want ? variants.findIndex((v) => v.key === want) : -1;
          setColor(idx >= 0 ? idx : 0);
        }
        renderThumbs();
        show(0);
      }
    </script>

    <footer class="site-footer container">ข้อมูลอัตโนมัติจากไฟล์ PDF — กรุณาตรวจสอบกับเอกสารต้นฉบับก่อนใช้งานจริง</footer>
  </body>
</html>
